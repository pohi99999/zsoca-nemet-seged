# GitHub Models API token (GitHub Copilot előfizetéssel elérhető, fine-grained
# PAT "models: read" scope-pal, vagy klasszikus token). Ha üresen marad, az app
# a beépített mock kérdésekkel/válaszokkal működik.
GITHUB_TOKEN=

# Opcionális: melyik modellt hívja a GitHub Models API. Alapértelmezett: openai/gpt-4o-mini
GITHUB_MODELS_DEFAULT_MODEL=

# Supabase projekt adatai (Settings > API a Supabase dashboardon)
# Ha üresen marad, az app localStorage-alapú, egy-eszközös memóriával működik.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
