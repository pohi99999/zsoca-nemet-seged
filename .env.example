# Google Gemini API kulcs (AI Studio: https://aistudio.google.com/apikey)
# Ha üresen marad, az app a beépített mock kérdésekkel/válaszokkal működik.
GEMINI_API_KEY=

# Supabase projekt adatai (Settings > API a Supabase dashboardon)
# Ha üresen marad, az app localStorage-alapú, egy-eszközös memóriával működik.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
